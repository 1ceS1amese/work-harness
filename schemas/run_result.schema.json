{
  "$defs": {
    "AgentAssignment": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/AllocationMode",
          "default": "auto"
        },
        "assignees": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Assignees",
          "type": "array"
        },
        "functions_by_agent": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/AgentFunction"
            },
            "type": "array"
          },
          "title": "Functions By Agent",
          "type": "object"
        },
        "cross_review": {
          "default": true,
          "title": "Cross Review",
          "type": "boolean"
        }
      },
      "title": "AgentAssignment",
      "type": "object"
    },
    "AgentFunction": {
      "enum": [
        "analysis",
        "research",
        "execution",
        "risk"
      ],
      "title": "AgentFunction",
      "type": "string"
    },
    "AllocationMode": {
      "enum": [
        "auto",
        "direct",
        "cross_functional"
      ],
      "title": "AllocationMode",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "subtask_id": {
          "title": "Subtask Id",
          "type": "string"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "content": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "unresolved_questions": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Questions",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus",
          "default": "success"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "subtask_id",
        "producer",
        "content",
        "confidence"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactStatus": {
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "target_subtasks": {
          "items": {
            "type": "string"
          },
          "title": "Target Subtasks",
          "type": "array"
        },
        "human_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Prompt"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reasons"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionAction": {
      "enum": [
        "approve",
        "repair",
        "request_human",
        "fail"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "source",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "title": "Node",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cached_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "fallback_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback From"
        },
        "skill_ids": {
          "items": {
            "type": "string"
          },
          "title": "Skill Ids",
          "type": "array"
        }
      },
      "required": [
        "node",
        "provider",
        "model"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "subtasks": {
          "items": {
            "$ref": "#/$defs/SubtaskSpec"
          },
          "minItems": 1,
          "title": "Subtasks",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "maxLength": 5000,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "subtasks"
      ],
      "title": "Plan",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_version": {
          "minimum": 1,
          "title": "Artifact Version",
          "type": "integer"
        },
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ReviewVerdict"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ReviewIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_version",
        "reviewer",
        "dimension",
        "verdict",
        "confidence"
      ],
      "title": "Review",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "recommendation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ReviewVerdict": {
      "enum": [
        "pass",
        "revise",
        "reject"
      ],
      "title": "ReviewVerdict",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RunError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RunError",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "waiting_human",
        "succeeded",
        "partial",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SkillSelection": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Skill Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "skill_id"
      ],
      "title": "SkillSelection",
      "type": "object"
    },
    "SubtaskSpec": {
      "additionalProperties": false,
      "properties": {
        "subtask_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Subtask Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "worker_role": {
          "default": "worker-01",
          "title": "Worker Role",
          "type": "string"
        },
        "assigned_function": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentFunction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logical_model": {
          "default": "worker-fast",
          "title": "Logical Model",
          "type": "string"
        },
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "skill_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Skill Ids",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "token_budget": {
          "default": 5000,
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        },
        "cost_budget_usd": {
          "default": 0.5,
          "minimum": 0,
          "title": "Cost Budget Usd",
          "type": "number"
        }
      },
      "required": [
        "subtask_id",
        "title",
        "description",
        "acceptance_criteria"
      ],
      "title": "SubtaskSpec",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output"
        },
        "task_type": {
          "default": "general",
          "title": "Task Type",
          "type": "string"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "assignment": {
          "$ref": "#/$defs/AgentAssignment"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillSelection"
          },
          "maxItems": 8,
          "title": "Skills",
          "type": "array"
        },
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "title": "Ambiguities",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "goal"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "ToolCallRecord": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "title": "Node",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "input_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Fingerprint",
          "type": "string"
        },
        "output_summary": {
          "title": "Output Summary",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        }
      },
      "required": [
        "node",
        "role",
        "tool_name",
        "call_id",
        "input_fingerprint",
        "output_summary"
      ],
      "title": "ToolCallRecord",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cached_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "output": {
      "default": "",
      "title": "Output",
      "type": "string"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/Plan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/Review"
      },
      "title": "Reviews",
      "type": "array"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/RunError"
      },
      "title": "Errors",
      "type": "array"
    },
    "repair_rounds": {
      "default": 0,
      "minimum": 0,
      "title": "Repair Rounds",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "model_calls": {
      "items": {
        "$ref": "#/$defs/ModelCallRecord"
      },
      "title": "Model Calls",
      "type": "array"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCallRecord"
      },
      "title": "Tool Calls",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status"
  ],
  "title": "RunResult",
  "type": "object"
}

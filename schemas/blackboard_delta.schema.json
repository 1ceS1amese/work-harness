        "parent_intent_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acceptance": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Acceptance",
          "type": "array"
        },
        "priority": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,

# Copy to deploy/runtime.distributed.env and keep mode 0600.
# Multi-instance mode intentionally uses one immutable environment Provider configuration.
WORK_HARNESS_API_KEY=replace-with-at-least-32-random-characters
MODEL_BASE_URL=https://models.example.com/v1
MODEL_API_KEY=replace-with-real-provider-key
MODEL_ID=replace-with-model-id
WORK_HARNESS_LOG_LEVEL=INFO

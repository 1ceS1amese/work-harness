# Copy this file to deploy/runtime.env. It is loaded only inside the container.
# Keep secrets out of compose.yaml and never commit deploy/runtime.env.

# Required when WORK_HARNESS_PROFILE=production enables API authentication.
WORK_HARNESS_API_KEY=

# Optional environment channel for the default compatible Provider. Set all three
# values together, or configure the Provider in the web UI instead.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# Add arbitrary variables referenced by persistent Provider Profiles below.
# TEAM_MODEL_BASE_URL=https://models.example.com/v1
# TEAM_MODEL_API_KEY=

# Optional telemetry exporter. Do not export prompts, secrets, or raw tool output.
OTEL_EXPORTER_OTLP_ENDPOINT=

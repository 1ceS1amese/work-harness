# Copy to deploy/runtime.env and keep the file permission at 0600.
# This deployment API Key protects the configuration page and all business APIs.
WORK_HARNESS_API_KEY=

# Optional Provider environment channel. Leave these blank when the Provider endpoint,
# API Key, protocol and models will be configured in the web UI instead.
MODEL_BASE_URL=
MODEL_API_KEY=

# Optional telemetry exporter. Never export prompts, credentials, or raw tool output.
OTEL_EXPORTER_OTLP_ENDPOINT=

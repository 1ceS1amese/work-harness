    "JsonValue": {},
    "Link": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "contributes_to",
            "refines",
            "supports",
            "contradicts",
            "supersedes"
          ],
          "title": "Relation",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "relation",
        "target"
      ],
      "title": "Link",
      "type": "object"
    },
    "ObjectChange": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/ObjectRef"
        },
        "action": {
          "enum": [
            "consume_hint",
            "dismiss_hint",
            "block_intent",
            "reopen_intent",
            "abandon_intent",
            "retract_fact"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target",
        "action",
        "reason"
      ],
      "title": "ObjectChange",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "revision"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ReadSelector": {
      "additionalProperties": false,
      "description": "The same bounded branch/topic projection that was supplied to a source.",
      "properties": {
        "intent_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Intent Id",
          "type": "string"
        },
        "input_topics": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Input Topics",
          "type": "array"
        },
        "accepted_kinds": {
          "default": [
            "fact",
            "hint",
            "intent"
          ],
          "items": {
            "enum": [
              "fact",
              "intent",
              "hint"
            ],
            "type": "string"
          },
          "title": "Accepted Kinds",
          "type": "array"
        }
      },
      "required": [
        "intent_id"
      ],
      "title": "ReadSelector",
      "type": "object"
    },
    "ViewPrecondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "view",
          "default": "view",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ReadSelector"
        },
        "expected_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 10000,
          "title": "Expected Refs",
          "type": "array"
        }
      },
      "required": [
        "selector",
        "expected_refs"
      ],
      "title": "ViewPrecondition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "proposals": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "fact": "#/$defs/FactProposal",
            "hint": "#/$defs/HintProposal",
            "intent": "#/$defs/IntentProposal"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FactProposal"
          },
          {
            "$ref": "#/$defs/IntentProposal"
          },
          {
            "$ref": "#/$defs/HintProposal"
          }
        ]
      },
      "maxItems": 100,
      "title": "Proposals",
      "type": "array"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectChange"
      },
      "maxItems": 100,
      "title": "Changes",
      "type": "array"
    },
    "read_set": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 10000,
      "title": "Read Set",
      "type": "array"
    },
    "concurrency": {
      "default": "snapshot",
      "enum": [
        "snapshot",
        "inputs"
      ],
      "title": "Concurrency",
      "type": "string"
    },
    "preconditions": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "fact_query": "#/$defs/FactQueryPrecondition",
            "hint_query": "#/$defs/HintQueryPrecondition",
            "intent_open": "#/$defs/IntentPrecondition",
            "view": "#/$defs/ViewPrecondition"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FactQueryPrecondition"
          },
          {
            "$ref": "#/$defs/HintQueryPrecondition"
          },
          {
            "$ref": "#/$defs/ViewPrecondition"
          },
          {
            "$ref": "#/$defs/IntentPrecondition"
          }
        ]
      },
      "maxItems": 256,
      "title": "Preconditions",
      "type": "array"
    },
    "goal_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalRevision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key"
  ],
  "title": "BlackboardDelta",
  "type": "object"
}

# Docker Compose controls. The default binds only to the current machine.
COMPOSE_PROJECT_NAME=work-harness
WORK_HARNESS_IMAGE=work-harness:local
WORK_HARNESS_BIND_ADDRESS=127.0.0.1
WORK_HARNESS_PORT=8000
WORK_HARNESS_DATA_VOLUME=work-harness-data
WORK_HARNESS_CPUS=2.0
WORK_HARNESS_MEMORY_LIMIT=2g
WORK_HARNESS_MEMORY_RESERVATION=512m

# Optional public HTTPS gateway (`./scripts/compose.sh public`).
WORK_HARNESS_DOMAIN=harness.example.com
WORK_HARNESS_HTTP_PORT=80
WORK_HARNESS_HTTPS_PORT=443

# Embedded runtime profile: setup | local | secure | production.
# setup is the safe first-run mode; local is an explicit Mock-only developer fixture.
# Use `./scripts/compose.sh init-distributed` and the dedicated distributed templates
# for PostgreSQL API/Worker mode; do not mix that profile into this embedded file.
WORK_HARNESS_PROFILE=setup
WORK_HARNESS_LOG_LEVEL=INFO

# The variables below support direct `uv run` development. For Compose, place
# runtime secrets and arbitrary Provider variables in deploy/runtime.env instead.
# Agent API. Required when the production profile enables authentication.
WORK_HARNESS_API_KEY=

# Optional environment-injected Provider. Set all three values together. The same
# endpoint, credential and model mapping can instead be saved in the UI.
# Leave these empty until a real Provider is supplied. `eval --prepare-comparison`
# only creates an unexecuted template and does not need credentials.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# Optional telemetry exporter. No prompts, secrets, or raw tool output should be exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional checkpoint override. Relative paths are resolved under the project root.
WORK_HARNESS_CHECKPOINT_PATH=var/checkpoints.sqlite
# New runs only; blackboard requests require explicit typed acceptance criteria.
WORK_HARNESS_WORKFLOW_ENGINE=blackboard
# Rollback: false rejects new blackboard runs while preserving existing runs.
WORK_HARNESS_ACCEPT_NEW_BLACKBOARD_RUNS=true
WORK_HARNESS_BLACKBOARD_PATH=var/blackboard.sqlite

# Optional durable run index override. Stores status and hashed fingerprints, not raw prompts.
WORK_HARNESS_RUN_STORE_PATH=var/runs.sqlite

# Optional durable Provider profile override. UI-managed keys are stored as ciphertext;
# the sibling .key file must remain private and be backed up with the database.
WORK_HARNESS_PROVIDER_STORE_PATH=var/providers.sqlite

# Optional persisted Agent prompt and safe runtime-setting overrides.
WORK_HARNESS_SETTINGS_PATH=var/settings.json

{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "claim_key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Claim Key",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "user_statement",
            "file_content",
            "tool_observation",
            "derived",
            "assessment",
            "delivery"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "operator": {
          "default": "exists",
          "enum": [
            "exists",
            "equals",
            "at_least",
            "at_most"
          ],
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "required_checks": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "claim_key",
        "claim_type"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "media_type": {
          "default": "text/plain",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 2000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_digest",
        "size_bytes"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_input",
            "file",
            "tool",
            "rule",
            "assessment",
            "delivery"
          ],
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "source",
        "locator",
        "content_digest",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FactProposal": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "topic": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "derived_from": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Derived From",
          "type": "array"
        },
        "links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "title": "Attachments",
          "type": "array"
        },
        "kind": {
          "const": "fact",
          "default": "fact",
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "user_statement",
            "file_content",
            "tool_observation",
            "derived",
            "assessment",
            "delivery"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "claim_key": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Key"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "premise_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Premise Refs",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "local_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Local Id",
          "type": "string"
        },
        "verification_receipt_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Verification Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "statement",
        "claim_type",
        "evidence",
        "local_id",
        "verification_receipt_id"
      ],
      "title": "FactProposal",
      "type": "object"
    },
    "FactQuery": {
      "additionalProperties": false,
      "properties": {
        "claim_key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Claim Key",
          "type": "string"
        },
        "claim_type": {
          "anyOf": [
            {
              "enum": [
                "user_statement",
                "file_content",
                "tool_observation",
                "derived",
                "assessment",
                "delivery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Type"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        }
      },
      "required": [
        "claim_key"
      ],
      "title": "FactQuery",
      "type": "object"
    },
    "FactQueryPrecondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fact_query",
          "default": "fact_query",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ReadSelector"
        },
        "query": {
          "$ref": "#/$defs/FactQuery"
        },
        "exists": {
          "title": "Exists",
          "type": "boolean"
        }
      },
      "required": [
        "selector",
        "query",
        "exists"
      ],
      "title": "FactQueryPrecondition",
      "type": "object"
    },
    "GoalRevision": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/ObjectRef"
        },
        "objective": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "acceptance": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Acceptance",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target",
        "objective",
        "acceptance",
        "reason"
      ],
      "title": "GoalRevision",
      "type": "object"
    },
    "HintProposal": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "topic": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",

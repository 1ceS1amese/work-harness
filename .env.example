# Runtime profile: local | test | production
WORK_HARNESS_PROFILE=local
WORK_HARNESS_LOG_LEVEL=INFO

# Agent API. Required only when config/api.yaml enables authentication.
WORK_HARNESS_API_KEY=

# OpenAI-compatible model endpoint. The default local profile uses Mock Provider.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=

# Optional telemetry exporter. No prompts, secrets, or raw tool output should be exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional checkpoint override. Relative paths are resolved under the project root.
WORK_HARNESS_CHECKPOINT_PATH=var/checkpoints.sqlite

# Optional durable run index override. Stores status and hashed fingerprints, not raw prompts.
WORK_HARNESS_RUN_STORE_PATH=var/runs.sqlite

          "default": null,
          "title": "Expires At"
        },
        "local_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Local Id",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "suggestion",
        "applies_when",
        "rationale",
        "local_id"
      ],
      "title": "HintProposal",
      "type": "object"
    },
    "HintQueryPrecondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hint_query",
          "default": "hint_query",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ReadSelector"
        },
        "topic": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "exists": {
          "title": "Exists",
          "type": "boolean"
        }
      },
      "required": [
        "selector",
        "topic",
        "exists"
      ],
      "title": "HintQueryPrecondition",
      "type": "object"
    },
    "IntentPrecondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "intent_open",

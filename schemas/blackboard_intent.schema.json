{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "claim_key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Claim Key",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "user_statement",
            "file_content",
            "tool_observation",
            "derived",
            "assessment",
            "delivery"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "operator": {
          "default": "exists",
          "enum": [
            "exists",
            "equals",
            "at_least",
            "at_most"
          ],
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "required_checks": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "claim_key",
        "claim_type"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "media_type": {
          "default": "text/plain",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 2000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_digest",
        "size_bytes"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "JsonValue": {},
    "Link": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "contributes_to",
            "refines",
            "supports",
            "contradicts",
            "supersedes"
          ],
          "title": "Relation",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "relation",
        "target"
      ],
      "title": "Link",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "revision"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scope": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Scope",
      "type": "object"
    },
    "topic": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "derived_from": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Derived From",
      "type": "array"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "attachments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContentRef"
      },
      "title": "Attachments",
      "type": "array"
    },
    "kind": {
      "const": "intent",
      "default": "intent",
      "title": "Kind",
      "type": "string"
    },
    "objective": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "root_intent_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_intent_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "acceptance": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Acceptance",
      "type": "array"
    },
    "priority": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "board_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Board Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "origin_activation_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Activation Id"
    },
    "content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "satisfied",
        "blocked",
        "abandoned"
      ],
      "title": "Status",
      "type": "string"
    },
    "satisfied_by": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Satisfied By",
      "type": "array"
    },
    "blockers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Blockers",
      "type": "array"
    },
    "status_reason": {
      "default": "",
      "title": "Status Reason",
      "type": "string"
    }
  },
  "required": [
    "topic",
    "objective",
    "acceptance",
    "id",
    "board_id",
    "revision",
    "created_at",
    "created_by",
    "content_digest"
  ],
  "title": "Intent",
  "type": "object"
}

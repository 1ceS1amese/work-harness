# Copy to .env, then replace the domain. The local image name is used by the
# source-build command; replace it with an immutable GHCR tag for install-production.
# Deployment secrets belong in deploy/runtime.env. Provider credentials can instead
# be entered in the Provider settings page after the first startup.
COMPOSE_PROJECT_NAME=work-harness
WORK_HARNESS_IMAGE=work-harness:production-local
WORK_HARNESS_PROFILE=production
WORK_HARNESS_BIND_ADDRESS=127.0.0.1
WORK_HARNESS_PORT=8000
WORK_HARNESS_DOMAIN=harness.example.com
WORK_HARNESS_HTTP_PORT=80
WORK_HARNESS_HTTPS_PORT=443
WORK_HARNESS_DATA_VOLUME=work-harness-data
WORK_HARNESS_CPUS=2.0
WORK_HARNESS_MEMORY_LIMIT=2g
WORK_HARNESS_MEMORY_RESERVATION=512m
WORK_HARNESS_LOG_LEVEL=INFO

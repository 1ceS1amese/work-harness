# Copy to .env.distributed and replace every placeholder before deployment.
COMPOSE_PROJECT_NAME=work-harness-distributed
WORK_HARNESS_IMAGE=work-harness:distributed-local
WORK_HARNESS_BIND_ADDRESS=127.0.0.1
WORK_HARNESS_PORT=8000
WORK_HARNESS_DATABASE_NAME=work_harness
WORK_HARNESS_DATABASE_USER=work_harness
WORK_HARNESS_DATABASE_PASSWORD=replace-with-at-least-32-random-characters
WORK_HARNESS_POSTGRES_VOLUME=work-harness-postgres

# Every API and Worker receives these same validated scheduling values.
WORK_HARNESS_RUN_MAX_CONCURRENCY=4
WORK_HARNESS_RUN_QUEUE_CAPACITY=32
WORK_HARNESS_RUN_QUEUE_RETRY_AFTER_SECONDS=5
WORK_HARNESS_RUN_TIMEOUT_SECONDS=300
WORK_HARNESS_RUN_LEASE_SECONDS=30
WORK_HARNESS_HEARTBEAT_INTERVAL_SECONDS=10
WORK_HARNESS_EXECUTION_POLL_INTERVAL_SECONDS=0.5
WORK_HARNESS_WORKER_STALE_SECONDS=30
WORK_HARNESS_JOB_MAX_ATTEMPTS=3
WORK_HARNESS_RETRY_BASE_SECONDS=2
WORK_HARNESS_RETRY_MAX_SECONDS=60

WORK_HARNESS_WORKER_CPUS=2.0
WORK_HARNESS_WORKER_MEMORY_LIMIT=2g
WORK_HARNESS_POSTGRES_MEMORY_LIMIT=1g
WORK_HARNESS_LOG_LEVEL=INFO

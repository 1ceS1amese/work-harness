        },
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "title": "Attachments",
          "type": "array"
        },
        "kind": {
          "const": "hint",
          "default": "hint",
          "title": "Kind",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        },
        "applies_when": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Applies When",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"

        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "topic": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "derived_from": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Derived From",
          "type": "array"
        },
        "links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "title": "Attachments",
          "type": "array"
        },
        "kind": {
          "const": "intent",
          "default": "intent",
          "title": "Kind",
          "type": "string"
        },
        "objective": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "root_intent_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"

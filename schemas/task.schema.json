{
  "$defs": {
    "AgentAssignment": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/AllocationMode",
          "default": "auto"
        },
        "assignees": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Assignees",
          "type": "array"
        },
        "functions_by_agent": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/AgentFunction"
            },
            "type": "array"
          },
          "title": "Functions By Agent",
          "type": "object"
        },
        "cross_review": {
          "default": true,
          "title": "Cross Review",
          "type": "boolean"
        }
      },
      "title": "AgentAssignment",
      "type": "object"
    },
    "AgentFunction": {
      "enum": [
        "analysis",
        "research",
        "execution",
        "risk"
      ],
      "title": "AgentFunction",
      "type": "string"
    },
    "AllocationMode": {
      "enum": [
        "auto",
        "direct",
        "cross_functional"
      ],
      "title": "AllocationMode",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "SkillSelection": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Skill Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "skill_id"
      ],
      "title": "SkillSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "goal": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "expected_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Output"
    },
    "task_type": {
      "default": "general",
      "title": "Task Type",
      "type": "string"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    },
    "assignment": {
      "$ref": "#/$defs/AgentAssignment"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillSelection"
      },
      "maxItems": 8,
      "title": "Skills",
      "type": "array"
    },
    "ambiguities": {
      "items": {
        "type": "string"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "goal"
  ],
  "title": "TaskSpec",
  "type": "object"
}

{
  "$defs": {
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "media_type": {
          "default": "text/plain",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 2000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_digest",
        "size_bytes"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_input",
            "file",
            "tool",
            "rule",
            "assessment",
            "delivery"
          ],
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "source",
        "locator",
        "content_digest",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {},
    "Link": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "contributes_to",
            "refines",
            "supports",
            "contradicts",
            "supersedes"
          ],
          "title": "Relation",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "relation",
        "target"
      ],
      "title": "Link",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "revision"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Receipt Id",
          "type": "string"
        },
        "verifier_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Verifier Id",
          "type": "string"
        },
        "verifier_version": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Verifier Version",
          "type": "string"
        },
        "method": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "premise_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Premise Refs",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "verifier_id",
        "verifier_version",
        "method",
        "verified_at",
        "content_digest"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scope": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Scope",
      "type": "object"
    },
    "topic": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "derived_from": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Derived From",
      "type": "array"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "attachments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContentRef"
      },
      "title": "Attachments",
      "type": "array"
    },
    "kind": {
      "const": "fact",
      "default": "fact",
      "title": "Kind",
      "type": "string"
    },
    "statement": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "claim_type": {
      "enum": [
        "user_statement",
        "file_content",
        "tool_observation",
        "derived",
        "assessment",
        "delivery"
      ],
      "title": "Claim Type",
      "type": "string"
    },
    "claim_key": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Key"
    },
    "value": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "premise_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Premise Refs",
      "type": "array"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "board_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Board Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "origin_activation_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Activation Id"
    },
    "content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "lifecycle": {
      "default": "valid",
      "enum": [
        "valid",
        "contested",
        "stale",
        "superseded",
        "expired",
        "retracted"
      ],
      "title": "Lifecycle",
      "type": "string"
    }
  },
  "required": [
    "topic",
    "statement",
    "claim_type",
    "evidence",
    "id",
    "board_id",
    "revision",
    "created_at",
    "created_by",
    "content_digest",
    "verification"
  ],
  "title": "Fact",
  "type": "object"
}
